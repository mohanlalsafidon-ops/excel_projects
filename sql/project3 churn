FROM food_churn
LIMIT 10;
describe returns;
SELECT customer_id
FROM returns
LIMIT 10;

SELECT
f.customer_id,
r.customer_id
FROM food_churn f
INNER JOIN returns r
ON REPLACE(f.customer_id, 'cust', '') = r.customer_id
LIMIT 10;

SELECT
f.customer_id,
f.city,
f.churned,
r.return_id,
r.reason,
r.refund_amount,
r.status
FROM food_churn f
LEFT JOIN returns r
ON REPLACE(f.customer_id, 'cust', '') = r.customer_id;

SELECT
COUNT(*) AS total_returns,
COUNT(DISTINCT customer_id) AS total_customers,
SUM(refund_amount) AS total_refund,
AVG(refund_amount) AS average_refund
FROM returns;

-----window function 

SELECT
customer_id,
city,
total_spend_90d_inr,
ROW_NUMBER() OVER (
ORDER BY total_spend_90d_inr DESC
) AS row_num
FROM food_churn;

---rank
SELECT
customer_id,
total_spend_90d_inr,
RANK() OVER (
ORDER BY total_spend_90d_inr DESC
) AS customer_rank
FROM food_churn;

----partation 
SELECT
customer_id,
city,
total_spend_90d_inr,
RANK() OVER (
PARTITION BY city
ORDER BY total_spend_90d_inr DESC
) AS city_rank
FROM food_churn;


