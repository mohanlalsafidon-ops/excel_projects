-----duplicate ccustomer id see
SELECT
customer_id,
COUNT(*) AS total
FROM food_churn
GROUP BY customer_id
HAVING COUNT(*) > 1;

SELECT gender, COUNT(*) AS total
FROM food_churn
GROUP BY gender;

---cheak null and blank 
SELECT COUNT(*) AS blank_city
FROM food_churn
WHERE city IS NULL OR TRIM(city) = '';

SELECT plan_type, COUNT(*) AS total
FROM food_churn
GROUP BY plan_type;

SELECT preferred_device, COUNT(*) AS total
FROM food_churn
GROUP BY preferred_device
ORDER BY total DESC;

-----aveg order value
SELECT
MIN(avg_order_value_inr) AS minimum_value,
MAX(avg_order_value_inr) AS maximum_value,
AVG(avg_order_value_inr) AS average_value
FROM food_churn;

SELECT
MIN(total_spend_90d_inr) AS minimum_spend,
MAX(total_spend_90d_inr) AS maximum_spend,
AVG(total_spend_90d_inr) AS average_spend
FROM food_churn;

----blank value cheak 
 SELECT
COUNT(DISTINCT gender) AS total_gender,
COUNT(DISTINCT city) AS total_city,
COUNT(DISTINCT plan_type) AS total_plan,
COUNT(DISTINCT preferred_device) AS total_device,
COUNT(DISTINCT signup_channel) AS total_channel,
COUNT(DISTINCT preferred_cuisine) AS total_cuisine,
COUNT(DISTINCT payment_method) AS total_payment
FROM food_churn;
SELECT
SUM(gender = '') AS blank_gender,
SUM(city = '') AS blank_city,
SUM(plan_type = '') AS blank_plan,
SUM(preferred_device = '') AS blank_device,
SUM(signup_channel = '') AS blank_channel,
SUM(preferred_cuisine = '') AS blank_cuisine,
SUM(payment_method = '') AS blank_payment
FROM food_churn;

----cheak duplicate value
 SELECT
customer_id,
age,
gender,
city,
signup_date,
COUNT(*) AS duplicate_count

SELECT
customer_id,
age,
gender,
city,
signup_date,
COUNT(*) AS duplicate_count
FROM food_churn
GROUP BY
customer_id,
age,
gender,
city,
signup_date
HAVING COUNT(*) > 1;

SELECT
MIN(signup_date) AS first_signup,
MAX(signup_date) AS last_signup,
COUNT(*) AS total_records
FROM food_churn;

----total spending
SELECT
COUNT(*) AS total_customers,
SUM(total_spend_90d_inr) AS total_spending,
AVG(total_spend_90d_inr) AS avg_spending
FROM food_churn;

----customer churn 
SELECT
COUNT(*) AS total_customers,
SUM(churned) AS churned_customers,
COUNT(*) - SUM(churned) AS active_customers
FROM food_churn;

---churn %%%%
 SELECT
ROUND(
SUM(churned) * 100.0 / COUNT(*), 2
) AS churn_percentage
FROM food_churn;

----highest churn
SELECT
city,
COUNT(*) AS total_customers,
SUM(churned) AS churned_customers
FROM food_churn
GROUP BY city
ORDER BY churned_customers DESC;

SELECT
plan_type,
COUNT(*) AS total_customers,
SUM(churned) AS churned_customers,
ROUND(AVG(churned) * 100, 2) AS churn_percentage
FROM food_churn
GROUP BY plan_type
ORDER BY churn_percentage DESC;

-------rating
SELECT
customer_rating,
COUNT(*) AS total_customers,
SUM(churned) AS churned_customers,
ROUND(AVG(churned) * 100, 2) AS churn_percentage
FROM food_churn
GROUP BY customer_rating
ORDER BY churn_percentage DESC;

----join
SELECT
f.customer_id,
f.city,
f.churned,
r.return_id,
r.reason,
r.refund_amount,
r.status
FROM food_churn f
INNER JOIN returns r
ON f.customer_id = r.customer_id;

