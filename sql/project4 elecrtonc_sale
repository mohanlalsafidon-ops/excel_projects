create database project4;
use project4;
show tables;
describe electronic_sales;
select count(*) from electronic_sales;
----cheak null value
SELECT
COUNT(*) AS total_records,
SUM(CASE WHEN `Customer ID` IS NULL THEN 1 ELSE 0 END) AS null_customer_id,
SUM(CASE WHEN Age IS NULL THEN 1 ELSE 0 END) AS null_age,
SUM(CASE WHEN Gender IS NULL THEN 1 ELSE 0 END) AS null_gender,
SUM(CASE WHEN Rating IS NULL THEN 1 ELSE 0 END) AS null_rating,
SUM(CASE WHEN `Total Price` IS NULL THEN 1 ELSE 0 END) AS null_total_price
FROM electronic_sales;

---duplicate row find
SELECT
`Customer ID`, Age, Gender, `Loyalty Member`,
`Product Type`, SKU, Rating, `Order Status`,
`Payment Method`, `Total Price`, `Unit Price`,
Quantity, `Purchase Date`, `Shipping Type`,
`Add-ons Purchased`, `Add-on Total`,
COUNT(*) AS duplicate_count
FROM electronic_sales
GROUP BY
`Customer ID`, Age, Gender, `Loyalty Member`,
`Product Type`, SKU, Rating, `Order Status`,
`Payment Method`, `Total Price`, `Unit Price`,
Quantity, `Purchase Date`, `Shipping Type`,
`Add-ons Purchased`, `Add-on Total`
HAVING COUNT(*) > 1;
----cheak blan value
SELECT
SUM(CASE WHEN TRIM(Gender) = '' THEN 1 ELSE 0 END) AS blank_gender,
SUM(CASE WHEN TRIM(`Loyalty Member`) = '' THEN 1 ELSE 0 END) AS blank_loyalty,
SUM(CASE WHEN TRIM(`Product Type`) = '' THEN 1 ELSE 0 END) AS blank_product,
SUM(CASE WHEN TRIM(SKU) = '' THEN 1 ELSE 0 END) AS blank_sku,
SUM(CASE WHEN TRIM(`Order Status`) = '' THEN 1 ELSE 0 END) AS blank_order,
SUM(CASE WHEN TRIM(`Payment Method`) = '' THEN 1 ELSE 0 END) AS blank_payment,
SUM(CASE WHEN TRIM(`Shipping Type`) = '' THEN 1 ELSE 0 END) AS blank_shipping,
SUM(CASE WHEN TRIM(`Add-ons Purchased`) = '' THEN 1 ELSE 0 END) AS blank_addons
FROM electronic_sales;

----rong value find
select * from electronic_sales where Age <18 or Age >100;

----date or price validation
SELECT
    'Invalid Purchase Date' AS check_type,
    COUNT(*) AS total
FROM electronic_sales
WHERE `Purchase Date` IS NULL

UNION ALL

SELECT 'Invalid Total Price', COUNT(*)
FROM electronic_sales
WHERE `Total Price` < 0

UNION ALL

SELECT 'Invalid Unit Price', COUNT(*)
FROM electronic_sales
WHERE `Unit Price` < 0

UNION ALL

SELECT 'Invalid Quantity', COUNT(*)
FROM electronic_sales
WHERE Quantity <= 0

UNION ALL

SELECT 'Invalid Add-on Total', COUNT(*)
FROM electronic_sales
WHERE `Add-on Total` < 0

UNION ALL

SELECT 'Shipping Type Missing', COUNT(*)
FROM electronic_sales
WHERE `Shipping Type` IS NULL
   OR TRIM(`Shipping Type`) = '';

----Product wise total sales
SELECT
`Product Type`,
SUM(`Total Price`) AS total_sales
FROM electronic_sales
GROUP BY `Product Type`
ORDER BY total_sales DESC;

---highest sales product
SELECT
`Product Type`,
SUM(Quantity) AS total_quantity
FROM electronic_sales
GROUP BY `Product Type`
ORDER BY total_quantity DESC
LIMIT 1;

------highest reenue genrate product
SELECT
`Product Type`,
SUM(`Total Price`) AS revenue
FROM electronic_sales
GROUP BY `Product Type`
ORDER BY revenue DESC
LIMIT 1;

---gender wise total customer
SELECT
Gender,
COUNT(DISTINCT `Customer ID`) AS total_customers
FROM electronic_sales
GROUP BY Gender;

-----gender wise total sales
SELECT
Gender,
ROUND(SUM(`Total Price`),2) AS total_sales
FROM electronic_sales
GROUP BY Gender
ORDER BY total_sales DESC;

----top 10 customer
SELECT
`Customer ID`,
COUNT(*) AS total_orders,
SUM(`Total Price`) AS total_spent
FROM electronic_sales
GROUP BY `Customer ID`
ORDER BY total_spent DESC
LIMIT 10;

----having
SELECT
`Loyalty Member`,
SUM(`Total Price`) AS total_sales
FROM electronic_sales
GROUP BY `Loyalty Member`
HAVING SUM(`Total Price`) > 100000;

---payment method wise sales
SELECT
`Payment Method`,
ROUND(SUM(`Total Price`),2) AS total_sales
FROM electronic_sales
GROUP BY `Payment Method`
ORDER BY total_sales DESC;

---shipping type wise revenue
SELECT
`Shipping Type`,
ROUND(SUM(`Total Price`),2) AS total_sales
FROM electronic_sales
GROUP BY `Shipping Type`
ORDER BY total_sales DESC;

----having or where combine use
SELECT
`Payment Method`,
COUNT(*) AS total_orders,
SUM(`Total Price`) AS total_sales
FROM electronic_sales
WHERE `Total Price` > 100
GROUP BY `Payment Method`
HAVING COUNT(*) > 10
ORDER BY total_sales DESC;

