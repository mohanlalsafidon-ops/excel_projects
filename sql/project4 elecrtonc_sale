----inter join 
SELECT
e.`Customer ID`,
e.Age,
e.Gender,
e.`Product Type`,
e.SKU,
r.return_id,
r.reason,
r.refund_amount,
r.requested_at,
r.status
FROM electronic_sales AS e
INNER JOIN returns AS r
ON e.`Customer ID` = r.customer_id;

